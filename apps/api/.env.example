# ─── إعدادات خادم روندي ───
# انسخ الملف ده باسم .env وغيّر القيم. الملف .env مابيترفعش على المستودع أبداً.

NODE_ENV=production
PORT=4000

# المستخدم اللي التطبيق بيشتغل بيه (صلاحيات قراءة/إضافة/تعديل بس، من غير مسح)
DATABASE_URL=postgresql://rondi_app:CHANGE_ME@localhost:5432/rondi
# المستخدم صاحب القاعدة، للترحيل (تعديل شكل الجداول) بس
DATABASE_MIGRATE_URL=postgresql://rondi_owner:CHANGE_ME@localhost:5432/rondi

# عنوان الشاشات اللي المستخدمين بيفتحوه (لازم يطابق بالظبط)
APP_ORIGIN=https://rondi.factory.local
# لازم true في التشغيل الحقيقي (الاتصال مشفر https)
COOKIE_SECURE=true
# لو في وسيط قدام الخادم (nginx/caddy) = 1
TRUST_PROXY=1

# مفتاح تشفير البيانات الحساسة: ٣٢ بايت عشوائي
# اعمله بالأمر: openssl rand -base64 32
# ⚠️ لو ضاع، أرقام الموبايل وأسرار الرمز الإضافي مش هتتفك. احفظه في مكان آمن برا السيرفر.
DATA_ENCRYPTION_KEY=

# الجلسات
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
SESSION_MAX_PER_USER=5

# الحماية من التخمين
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
THROTTLE_LIMIT_PER_MINUTE=300
THROTTLE_LOGIN_PER_MINUTE=10

# أول تشغيل: كلمة سر مبدئية لحساب admin (لازم تتغير أول دخول)
SEED_ADMIN_PASSWORD=
# بيانات تجريبية: true للتجربة بس، ممنوع في التشغيل الحقيقي
SEED_DEMO=false
SEED_DEMO_PASSWORD=
