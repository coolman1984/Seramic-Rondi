{
  "name": "rondi",
  "private": true,
  "description": "نظام روندي لإدارة مصنع السيراميك",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @rondi/api db:migrate",
    "db:seed": "pnpm --filter @rondi/api db:seed"
  }
}
