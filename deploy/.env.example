# ══════ إعدادات تشغيل روندي على سيرفر المصنع ══════
# انسخ الملف باسم .env واملا كل القيم. الملف .env مابيترفعش ولا يتبعت لحد.
# كل كلمات السر: اعملها بالأمر  openssl rand -base64 24

# اسم السيرفر اللي الأجهزة هتفتحه (مثلاً rondi.local أو 192.168.1.20)
SITE_ADDRESS=rondi.local
# internal = شهادة للشبكة الداخلية. أو اكتب إيميلك لو السيرفر ليه اسم على الإنترنت
TLS_MODE=internal

# قاعدة البيانات
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# مفتاح تشفير البيانات الحساسة — اعمله بالأمر: openssl rand -base64 32
# ⚠️ احفظ نسخة منه برا السيرفر. لو ضاع، البيانات المتشفرة مش هتتفك.
DATA_ENCRYPTION_KEY=

# النسخ الاحتياطي
# ⚠️ احفظ كلمة السر دي برا السيرفر كمان. من غيرها النسخ مش هتترجع.
BACKUP_PASSPHRASE=
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
BACKUP_LOCAL_PATH=./backups
# فولدر على جهاز تاني (NAS / هارد خارجي متركّب على السيرفر) لنسخة برا
BACKUP_OFFSITE_DIR=

# أول تشغيل بس: RUN_SEED=true وكلمة سر مبدئية لـ admin (هيطلب تغييرها أول دخول)
RUN_SEED=true
SEED_ADMIN_PASSWORD=
# بيانات تجريبية: false في التشغيل الحقيقي
SEED_DEMO=false
SEED_DEMO_PASSWORD=
